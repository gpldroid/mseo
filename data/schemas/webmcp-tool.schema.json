{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fastseo.site/data/schemas/webmcp-tool.schema.json",
  "title": "WebMCP Tool Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "description",
    "page",
    "inputSchema"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,63}$"
    },
    "description": {
      "type": "string",
      "minLength": 10
    },
    "page": {
      "type": "string",
      "pattern": "^/"
    },
    "inputSchema": {
      "type": "object",
      "required": [
        "type",
        "properties"
      ],
      "properties": {
        "type": {
          "const": "object"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "type",
              "description"
            ],
            "properties": {
              "type": {
                "enum": [
                  "string",
                  "integer",
                  "number",
                  "boolean",
                  "array",
                  "object"
                ]
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "additionalProperties": {
          "type": "boolean"
        }
      }
    }
  }
}
