---
import Layout from '../../layouts/Layout.astro';
import articles from '../../../data/articles.json';
const sorted=[...articles].sort((a,b)=>new Date(b.updatedAt||b.publishedAt||0)-new Date(a.updatedAt||a.publishedAt||0));
const categories=[...new Set(sorted.map(a=>a.category).filter(Boolean))];
---
<Layout title="أرشيف المقالات | MSEO" description="تصفح مكتبة MSEO وابحث في المقالات والأدلة التقنية حسب المجال والكلمات المفتاحية.">
<main class="container page-shell"><section class="page-hero"><span class="eyebrow">MSEO KNOWLEDGE LIBRARY</span><h1>أرشيف <em>المقالات والأدلة</em></h1><p>ابحث في المكتبة التقنية، أو صفِّ النتائج حسب المجال، واكتشف الدليل المناسب لاحتياجك.</p><div class="page-stats"><span><strong>{sorted.length}</strong> مقالاً ودليلاً</span><span><strong>{categories.length}</strong> مجالات معرفية</span></div></section>
<section class="archive-tools" aria-label="البحث والتصفية"><label class="search-field"><span aria-hidden="true">⌕</span><input id="article-search" type="search" placeholder="ابحث بالعنوان أو الوصف أو الكلمات المفتاحية…" autocomplete="off"><kbd>/</kbd></label><label class="filter-field"><span>التصنيف</span><select id="article-category"><option value="">كل المجالات</option>{categories.map(c=><option value={c}>{c}</option>)}</select></label><label class="filter-field"><span>ترتيب النتائج</span><select id="article-sort"><option value="newest">الأحدث أولاً</option><option value="oldest">الأقدم أولاً</option><option value="title">العنوان أبجدياً</option></select></label></section>
<div class="archive-status"><p id="archive-count" aria-live="polite">{sorted.length} نتيجة</p><button id="clear-filters" type="button">مسح الفلاتر</button></div>
<section id="article-grid" class="article-grid" aria-label="قائمة المقالات">{sorted.map(a=><article class="article-card" data-search={[a.title,a.description,a.category,a.subcategory,...(a.tags||[])].join(" ").toLowerCase()} data-category={a.category||""} data-date={a.updatedAt||a.publishedAt||""} data-title={a.title}><a class="article-card__image" href={'/articles/'+(a.file||a.slug+'.html')}><img src={a.image||a.thumbnail||'/favicon.svg'} alt="" loading="lazy" decoding="async"></a><div class="article-card__body"><span class="article-card__category">{a.category||'مقالات'}</span><h2><a href={'/articles/'+(a.file||a.slug+'.html')}>{a.title}</a></h2><p>{a.description||'اقرأ الدليل الكامل واكتشف الخطوات العملية.'}</p><div class="article-card__meta"><time>{a.updatedAt||a.publishedAt||''}</time><a href={'/articles/'+(a.file||a.slug+'.html')}>اقرأ المقال ←</a></div></div></article>)}</section>
<p id="archive-empty" class="empty-state" hidden>لا توجد نتائج مطابقة. جرّب تغيير عبارة البحث أو التصنيف.</p><nav class="pagination" id="article-pagination" aria-label="صفحات المقالات"><button type="button" id="page-prev" disabled>السابق</button><span id="page-indicator">1 / 1</span><button type="button" id="page-next" disabled>التالي</button></nav></main><script>import '../../scripts/archive-search.js';</script></Layout>