---
import Layout from '../layouts/Layout.astro';import articles from '../../data/articles.json';
const latest=[...articles].sort((a,b)=>new Date(b.updatedAt||b.publishedAt||0)-new Date(a.updatedAt||a.publishedAt||0)).slice(0,9);
const cats=[...new Set(articles.map(a=>a.category).filter(Boolean))].slice(0,8);
---
<Layout><main><section class="hero"><div class="container hero-grid"><div><span class="eyebrow">MSEO · DIGITAL KNOWLEDGE</span><h1>ابنِ حضورك الرقمي<br/>بمعرفة أذكى.</h1><p class="hero-copy">من الذكاء الاصطناعي إلى البرمجة وتحسين محركات البحث؛ اكتشف شروحات تقنية عملية، منظمة، ومصممة لمساعدتك على تحويل الأفكار إلى نتائج.</p><div class="hero-actions"><a class="gold-button" href="#articles">استكشف المقالات</a><a class="outline" href="/pages/tools.html">اكتشف الأدوات</a></div></div><div class="visual"><div class="cube"><b>MSEO</b></div></div></div></section><section class="section" id="articles"><div class="container"><div class="section-head"><div><span class="eyebrow">LATEST INSIGHTS</span><h2>أحدث المقالات</h2><p class="intro">محتوى مختار يساعدك على التعلم والتطبيق ومواكبة التقنيات الحديثة.</p></div><a class="read" href="/pages/archive.html">كل المقالات ←</a></div><div class="grid">{latest.map(a=><article class="card"><div class="art">✦</div><div class="content"><span class="category">{a.category||'مقالات'}</span><h3>{a.title}</h3><p>{a.description||'اقرأ الدليل الكامل واكتشف الخطوات والتطبيقات العملية.'}</p><small>{a.updatedAt||a.publishedAt||''}</small><br/><a class="read" href={'/articles/'+(a.file||a.slug+'.html')}>اقرأ المقال ←</a></div></article>)}</div></div></section><section class="section"><div class="container"><span class="eyebrow">EXPLORE TOPICS</span><h2>تصفح حسب المجال</h2><div class="categories">{cats.map(c=><a class="tile" href={c==='SEO'?'/pages/seo.html':c.includes('برمجة')?'/pages/programming.html':c.includes('ذكاء')?'/pages/ai.html':'/pages/topics.html'}><b>{c}</b><span>اكتشف الأدلة والمقالات ←</span></a>)}</div></div></section></main></Layout>