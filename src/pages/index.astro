---
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import articles from '../../data/articles.json';
const latest=[...articles].sort((a,b)=>new Date(b.updatedAt||b.publishedAt||0)-new Date(a.updatedAt||a.publishedAt||0)).slice(0,9);
const cats=[{name:'SEO',slug:'seo',icon:'⌕',desc:'الفهرسة والكلمات المفتاحية والتحسين التقني.'},{name:'الذكاء الاصطناعي',slug:'ai',icon:'✧',desc:'النماذج والأوامر والوكلاء والأتمتة.'},{name:'البرمجة',slug:'programming',icon:'⌘',desc:'JavaScript وTypeScript وأدوات المطورين.'},{name:'تطوير المواقع',slug:'web-development',icon:'◇',desc:'HTML وCSS وبناء المواقع المتجاوبة.'},{name:'أداء المواقع',slug:'web-performance',icon:'↗',desc:'السرعة وCore Web Vitals.'},{name:'تصميم المواقع',slug:'web-design',icon:'▧',desc:'واجهات المستخدم وتجربة الاستخدام.'}];
---
<Layout title="MSEO | المعرفة التقنية بأسلوب عملي" description="أدلة عملية في الذكاء الاصطناعي والبرمجة وتطوير المواقع وتحسين محركات البحث.">
<main>
<section class="hero"><div class="container hero-grid"><div><span class="eyebrow">MSEO · DIGITAL KNOWLEDGE</span><h1>ابنِ حضورك الرقمي<br/><em>بمعرفة أذكى.</em></h1><p class="hero-copy">من الذكاء الاصطناعي إلى البرمجة وتحسين محركات البحث؛ اكتشف شروحات تقنية عملية، منظمة، ومصممة لمساعدتك على تحويل الأفكار إلى نتائج.</p><div class="hero-actions"><a class="gold-button" href="#articles">استكشف المقالات</a><a class="outline" href="/pages/tools.html">اكتشف الأدوات</a></div><div class="hero-socials" aria-label="مشاركة MSEO"><a class="social-3d" href="https://www.facebook.com/sharer/sharer.php?u=https%3A%2F%2Ffastseo.site%2F" target="_blank" rel="noopener noreferrer" aria-label="مشاركة MSEO على Facebook">f</a><a class="social-3d" href="https://twitter.com/intent/tweet?url=https%3A%2F%2Ffastseo.site%2F&text=MSEO" target="_blank" rel="noopener noreferrer" aria-label="مشاركة MSEO على X">𝕏</a><a class="social-3d" href="https://www.linkedin.com/sharing/share-offsite/?url=https%3A%2F%2Ffastseo.site%2F" target="_blank" rel="noopener noreferrer" aria-label="مشاركة MSEO على LinkedIn">in</a></div></div><div class="visual"><div class="cube"><b>MSEO</b></div></div></div></section>
<section class="section" id="articles"><div class="container"><div class="section-head"><div><span class="eyebrow">LATEST INSIGHTS</span><h2>أحدث المقالات</h2><p class="intro">محتوى مختار يساعدك على التعلم والتطبيق ومواكبة التقنيات الحديثة.</p></div><a class="read" href="/archive">كل المقالات ←</a></div><div class="astro-grid">{latest.map(article=><ArticleCard article={article}/>)}</div></div></section>
<section class="section topics-section"><div class="container"><div class="section-head"><div><span class="eyebrow">EXPLORE TOPICS</span><h2>تصفح حسب المجال</h2><p class="intro">انتقل مباشرة إلى مجموعة الأدلة المرتبطة باهتماماتك.</p></div><a class="read" href="/categories">كل التصنيفات ←</a></div><div class="topic-grid">{cats.map(category=><a class="topic-card" href={'/topics/'+category.slug}><span class="topic-icon" aria-hidden="true">{category.icon}</span><strong>{category.name}</strong><span>{category.desc}</span><b>استكشف الأدلة ←</b></a>)}</div></div></section>
<section class="section tools-promo"><div class="container tools-promo-inner"><div><span class="eyebrow">MSEO TOOLKIT</span><h2>أدوات عملية لإنجاز أسرع</h2><p>استخدم أدوات الويب المجانية للمطورين وأصحاب المواقع، من تحليل SEO إلى أدوات النصوص والصور.</p></div><a class="gold-button" href="/pages/tools.html">استكشف الأدوات ←</a></div></section>
<section class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">START EXPLORING</span><h2>ابدأ من هنا</h2></div></div><div class="start-links"><a href="/archive">مكتبة المقالات والأدلة</a><a href="/categories">التصنيفات والموضوعات</a><a href="/pages/about.html">تعرف على MSEO</a><a href="/pages/contact.html">تواصل معنا</a></div></div></section>
</main></Layout>