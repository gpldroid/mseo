---
import Layout from '../layouts/Layout.astro';
import HomeArticleCard from '../components/HomeArticleCard.astro';
import '../styles/homepage.css';
import articles from '../../data/articles.json';
const sorted=[...articles].sort((a,b)=>new Date(b.updatedAt||b.publishedAt||0)-new Date(a.updatedAt||a.publishedAt||0));
const ticker=sorted.slice(0,4),latest=sorted.slice(0,6),oldest=[...sorted].reverse().slice(0,6),featured=sorted.slice(0,8),more=sorted.slice(8),discover=sorted.slice(8,12);
const cats=[{name:'تحسين محركات البحث',slug:'seo',icon:'⌕',desc:'استراتيجيات الظهور والفهرسة والكلمات المفتاحية.'},{name:'الذكاء الاصطناعي',slug:'ai',icon:'✧',desc:'أدوات ونماذج وتطبيقات الذكاء الاصطناعي.'},{name:'البرمجة',slug:'programming',icon:'⌘',desc:'لغات البرمجة وأدوات المطورين.'},{name:'تطوير المواقع',slug:'web-development',icon:'◇',desc:'بناء المواقع وتطوير الواجهات.'},{name:'أداء المواقع',slug:'web-performance',icon:'↗',desc:'السرعة وتجربة المستخدم ومؤشرات الويب.'},{name:'تصميم المواقع',slug:'web-design',icon:'▧',desc:'التصميم وتجربة الاستخدام وواجهات الويب.'}];
---
<Layout title="MSEO | مقالات ومواضيع وأدوات تقنية" description="اكتشف أحدث المقالات والمواضيع التقنية والأدوات العملية في الذكاء الاصطناعي والبرمجة وتطوير المواقع وتحسين محركات البحث.">
<main class="home-page">
<section class="news-ticker-section" aria-label="آخر الأخبار والمقالات"><div class="container"><div class="news-ticker-heading"><span class="live-dot"></span><strong>آخر المقالات</strong><span>تحديثات MSEO</span></div><div class="news-ticker-grid">{ticker.map((article,index)=><a class="ticker-3d-card" href={'/articles/'+(article.file||article.slug+'.html')}><span class="ticker-content"><small>{article.category||'مقالات'}</small><strong>{article.title}</strong><time>{article.updatedAt||article.publishedAt||''}</time></span></a>)}</div></div></section>
<section class="home-hero"><div class="container home-hero-grid"><div class="home-hero-copy"><h1>مقالات ومواضيع<br/><em>وأدوات تصنع الفرق.</em></h1><p>وجهتك للمعرفة التقنية العملية؛ مقالات متخصصة، مواضيع حديثة، وأدوات تساعدك على التعلم والإنجاز وتطوير حضورك الرقمي.</p><div class="home-hero-actions"><a class="gold-button" href="#main-articles">تصفح المقالات <span>←</span></a><a class="outline" href="/pages/tools.html">اكتشف الأدوات</a></div><div class="home-hero-meta"><span>مقالات عملية</span><i></i><span>موضوعات متجددة</span><i></i><span>أدوات مفيدة</span></div></div><div class="home-hero-visual" aria-hidden="true"><div class="hero-orbit orbit-one"></div><div class="hero-orbit orbit-two"></div><div class="hero-cube"><span>MSEO</span></div><div class="hero-cube-shadow"></div><div class="hero-visual-label">THINK · BUILD · GROW</div></div></div></section>
<section class="home-topics section"><div class="container"><div class="section-head"><div><h2>استكشف المجالات</h2><p class="intro">اختر المجال للوصول إلى الأدلة والموضوعات المرتبطة به.</p></div><a class="read" href="/categories">جميع المجالات ←</a></div><div class="home-topic-grid">{cats.map(category=><a class="home-topic-3d" href={'/topics/'+category.slug}><span class="home-topic-icon">{category.icon}</span><strong>{category.name}</strong><p>{category.desc}</p><span class="home-topic-link">اكتشف المجال ←</span></a>)}</div></div></section>
<section class="home-content-section section" id="main-articles"><div class="container"><div class="section-head"><div><h2>المقالات والمواضيع</h2><p class="intro">أحدث الشروحات والأدلة المختارة من مكتبة MSEO.</p></div><a class="read" href="/archive">كل المقالات ←</a></div><div class="home-content-layout"><div class="home-main-column"><div class="home-articles-grid" id="home-articles-grid">{featured.map((article,index)=><HomeArticleCard article={article} index={index}/>)}{more.map((article,index)=><HomeArticleCard article={article} index={index+8} initiallyHidden={true}/>)}</div>{more.length>0&&<div class="home-load-more-wrap"><button class="home-load-more" type="button" id="home-load-more" data-batch="8">تحميل المزيد من المقالات <span aria-hidden="true">＋</span></button><p id="home-load-status" class="home-load-status" aria-live="polite">نعرض 8 مقالات من أصل {sorted.length}</p></div>}</div><aside class="home-sidebar" aria-label="مقالات جديدة وقديمة"><section class="home-sidebar-panel"><div class="home-sidebar-heading"><span class="sidebar-heading-icon">↗</span><div><h3>مقالات جديدة</h3><small>أحدث ما نُشر</small></div></div><div class="home-side-list">{latest.map((article,index)=><a class="home-side-link" href={'/articles/'+(article.file||article.slug+'.html')}><span><small>{article.category||'مقالات'}</small><strong>{article.title}</strong></span></a>)}</div><a class="home-sidebar-more" href="/archive">عرض الأرشيف ←</a></section><section class="home-sidebar-panel home-sidebar-panel--old"><div class="home-sidebar-heading"><span class="sidebar-heading-icon">◷</span><div><h3>من الأرشيف</h3><small>مقالات سابقة تستحق القراءة</small></div></div><div class="home-side-list">{oldest.map((article,index)=><a class="home-side-link" href={'/articles/'+(article.file||article.slug+'.html')}><span><small>{article.category||'مقالات'}</small><strong>{article.title}</strong></span></a>)}</div><a class="home-sidebar-more" href="/archive">استكشف المقالات السابقة ←</a></section></aside></div></div></section>
<section class="home-tools-section section"><div class="container"><div class="home-tools-panel"><div class="home-tools-art" aria-hidden="true"><span>✧</span><b>TOOLS</b></div><div class="home-tools-copy"><h2>أدوات رقمية في مكان واحد</h2><p>استخدم أدوات عملية تساعدك في SEO والكتابة والبرمجة وتحليل المحتوى وإنجاز المهام اليومية.</p><a class="gold-button" href="/pages/tools.html">استكشف مكتبة الأدوات ←</a></div></div></div></section>
<section class="home-discover-section section"><div class="container"><div class="section-head"><div><h2>مقالات تستحق القراءة</h2><p class="intro">تابع اكتشاف الأدلة والموضوعات من مكتبة MSEO.</p></div><a class="read" href="/archive">المزيد من المقالات ←</a></div><div class="home-discover-track">{discover.map(article=><a class="discover-3d-card" href={'/articles/'+(article.file||article.slug+'.html')}><span class="discover-card-image">{article.image||article.thumbnail?<img src={article.image||article.thumbnail} alt="" loading="lazy" width="360" height="203"/>:<b>✦</b>}</span><span class="discover-card-copy"><small>{article.category||'مقالات'}</small><strong>{article.title}</strong><span>اقرأ المقال ←</span></span></a>)}</div></div></section>
</main><script src="/assets/js/homepage.js?v=20261126-home-layout" defer></script></Layout>