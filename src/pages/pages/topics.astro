---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import catalog from '../../../data/articles.json';

const definitions = [
  { name: 'SEO', slug: 'seo', description: 'الكلمات المفتاحية، الفهرسة، والروابط الداخلية.' },
  { name: 'تطوير المواقع', slug: 'web-development', description: 'HTML وCSS وبناء صفحات الويب.' },
  { name: 'أداء المواقع', slug: 'performance', description: 'السرعة ومؤشرات Core Web Vitals.' },
  { name: 'تصميم المواقع', slug: 'web-design', description: 'التصميم المتجاوب وتجربة المستخدم.' },
  { name: 'البرمجة', slug: 'programming', description: 'لغات البرمجة ومهارات المطورين.' },
  { name: 'الذكاء الاصطناعي', slug: 'ai', description: 'أدوات الذكاء الاصطناعي وهندسة الأوامر.' }
];
const categories = definitions.map((category) => ({
  ...category,
  articles: catalog.filter((item) => item.category === category.name)
    .sort((a, b) => String(b.updatedAt || b.publishedAt || '').localeCompare(String(a.updatedAt || a.publishedAt || '')))
})).filter((category) => category.articles.length > 0);
---
<SiteLayout title="المقالات حسب التصنيف | فاست سيو — Fast Seo" description="استكشف مقالات فاست سيو حسب الموضوع: SEO وتطوير المواقع والأداء والتصميم والبرمجة والذكاء الاصطناعي.">
  <main>
    <section class="mseo-hero">
      <span class="mseo-eyebrow">مكتبة المقالات</span>
      <h1>مقالات مرتبة حسب <em>الموضوع</em></h1>
      <p>تصفح عناوين مختارة من كل قسم، ثم انتقل إلى بقية المقالات في التصنيف الذي يهمك.</p>
      <a class="mseo-button secondary" href="/pages/categories.html">جميع التصنيفات</a>
    </section>
    <nav class="mseo-topic-jump mseo-section" aria-label="التنقل بين أقسام المقالات">
      <span>انتقل مباشرة إلى القسم:</span>
      {categories.map((category) => <a href={`#topic-${category.slug}`}>{category.name}</a>)}
    </nav>
    <div class="mseo-section mseo-topic-sections">
      {categories.map((category) => (
        <section class="mseo-topic-section" id={`topic-${category.slug}`} aria-labelledby={`title-${category.slug}`}>
          <div class="mseo-section-head">
            <div><span class="mseo-eyebrow">تصنيف</span><h2 id={`title-${category.slug}`}>{category.name}</h2><p>{category.description}</p></div>
            <span class="mseo-category-total">{category.articles.length} مقال</span>
          </div>
          <div class="mseo-article-grid">
            {category.articles.slice(0, 3).map((article) => <ArticleCard article={article} />)}
          </div>
          <div class="mseo-topic-more"><a class="mseo-button secondary" href={`/pages/archive.html?category=${encodeURIComponent(category.name)}`}>اقرأ المزيد من {category.name}</a></div>
        </section>
      ))}
    </div>
  </main>
</SiteLayout>
<style>
  .mseo-topic-jump{display:flex;align-items:center;gap:9px;flex-wrap:wrap}
  .mseo-topic-jump>span{width:100%;font-weight:900}
  .mseo-topic-jump>a{padding:7px 13px;border:1px solid var(--line);border-radius:999px;background:var(--surface);color:var(--ink);font-size:.86rem;font-weight:800}
  .mseo-topic-jump>a:hover{border-color:var(--gold);color:var(--gold-deep)}
  .mseo-topic-section{padding:28px 0 36px;border-bottom:1px solid var(--line);scroll-margin-top:100px}
  .mseo-topic-section:last-child{border-bottom:0}
  .mseo-topic-section .mseo-section-head h2{margin:5px 0;font-size:clamp(1.4rem,3vw,1.9rem);font-weight:900}
  .mseo-article-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
  .mseo-topic-more{margin-top:18px}
  @media(max-width:850px){.mseo-article-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:600px){.mseo-article-grid{grid-template-columns:1fr}.mseo-topic-section{padding:22px 0 28px}}
</style>
