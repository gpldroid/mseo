---
import SiteLayout from '../../layouts/SiteLayout.astro';
import CategoryCard from '../../components/CategoryCard.astro';
import catalog from '../../../data/articles.json';

const definitions = [
  { name: 'SEO', slug: 'seo', description: 'أدلة تحسين محركات البحث والفهرسة والروابط الداخلية واستراتيجية المحتوى.', icon: '⌕', image: '/assets/images/category-social/seo.svg' },
  { name: 'تطوير المواقع', slug: 'web-development', description: 'HTML وCSS وبناء صفحات ويب عملية وسريعة ومتوافقة مع معايير الويب.', icon: '</>', image: '/assets/images/category-social/development.svg' },
  { name: 'أداء المواقع', slug: 'performance', description: 'السرعة وتجربة المستخدم وCore Web Vitals وتحسين كفاءة الصفحات.', icon: '↗', image: '/assets/images/category-social/performance.svg' },
  { name: 'تصميم المواقع', slug: 'web-design', description: 'الواجهات والتصميم المتجاوب والطباعة العربية وتجارب الاستخدام.', icon: '◇', image: '/assets/images/category-social/web-design.svg' },
  { name: 'البرمجة', slug: 'programming', description: 'JavaScript وأساسيات البرمجة وتنظيم الكود وتصحيح الأخطاء.', icon: '{ }', image: '/assets/images/category-social/programming.svg' },
  { name: 'الذكاء الاصطناعي', slug: 'ai', description: 'أدوات الذكاء الاصطناعي وكتابة Prompts وتطبيقاتها العملية.', icon: '✧', image: '/assets/images/category-social/ai.svg' }
];
const categories = definitions
  .map((category) => ({ ...category, count: catalog.filter((item) => item.category === category.name).length }))
  .filter((category) => category.count > 0);
---
<SiteLayout title="التصنيفات | فاست سيو — Fast Seo" description="تصفح تصنيفات فاست سيو واكتشف مقالات وأدلة SEO والبرمجة وتطوير المواقع والذكاء الاصطناعي.">
  <main>
    <section class="mseo-hero">
      <span class="mseo-eyebrow">استكشف المكتبة</span>
      <h1>تصفّح حسب <em>التصنيف</em></h1>
      <p>اختر المجال الذي يهمك، واستكشف مقالات وأدلة عملية مرتبة لتصل إلى المعلومة المناسبة بسرعة.</p>
      <div class="mseo-hero-actions">
        <a class="mseo-button" href="/pages/topics.html">المقالات حسب التصنيف</a>
        <a class="mseo-button secondary" href="/pages/archive.html">كل المقالات</a>
      </div>
    </section>
    <section class="mseo-section">
      <div class="mseo-section-head">
        <div><h2>كل التصنيفات في مكان واحد</h2><p>تُحتسب المقالات من فهرس المحتوى الموحد.</p></div>
        <span class="mseo-category-total">{categories.length} تصنيفات · {catalog.length} مقالًا</span>
      </div>
      <div class="mseo-category-grid">
        {categories.map((category) => <CategoryCard category={category} />)}
      </div>
    </section>
    <section class="mseo-section mseo-category-cta">
      <div><span class="mseo-eyebrow">ابدأ الاستكشاف</span><h2>هل تبحث عن مقال محدد؟</h2><p>استخدم أرشيف المقالات للبحث والتصفية حسب التصنيف.</p></div>
      <a class="mseo-button" href="/pages/archive.html">افتح أرشيف المقالات</a>
    </section>
  </main>
</SiteLayout>
<style>
  .mseo-category-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}
  .mseo-category-total{flex:none;padding:6px 12px;border:1px solid var(--line);border-radius:999px;color:var(--gold-deep);font-size:.82rem;font-weight:900}
  .mseo-category-cta{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:28px;border-radius:20px;background:var(--paper-deep)}
  .mseo-category-cta h2{margin:8px 0;font-size:1.5rem;font-weight:900}
  .mseo-category-cta p{margin:0;color:var(--muted)}
  @media(max-width:850px){.mseo-category-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:600px){.mseo-category-grid{grid-template-columns:1fr}.mseo-category-cta{align-items:flex-start;flex-direction:column;padding:22px}}
</style>
