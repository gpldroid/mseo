---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ToolCard from '../../components/ToolCard.astro';
import tools from '../../generated/tools-catalog.json';
const categories = [...new Set(tools.map((tool) => tool.kicker).filter(Boolean))].sort((a,b) => a.localeCompare(b, 'ar'));
---
<SiteLayout title="أدوات مجانية للمدونين والمطورين | فاست سيو | Fast Seo" description="استخدم أدوات فاست سيو المجانية للمدونين والمطورين: أدوات SEO والبرمجة والتصميم وتحسين الأداء، تعمل مباشرة من المتصفح.">
  <main>
    <section class="mseo-hero">
      <span class="mseo-eyebrow">THE TOOLKIT</span>
      <h1>استكشف <em>الأدوات والتقنيات</em></h1>
      <p>مجموعة أدوات ويب عملية للمدونين والمطورين، تساعدك على تحليل الصفحات وتنسيق البيانات وتحسين المحتوى والتصميم والأداء مباشرة من المتصفح.</p>
      <div class="mseo-hero-actions">
        <a class="mseo-button" href="#tool-directory">تصفح الأدوات</a>
        <a class="mseo-button secondary" href="/pages/categories.html">استكشف الأدلة</a>
      </div>
      <img class="mseo-tools-hero-image" src="/assets/images/fastseo-tools-hero.svg" alt="مجموعة أدوات فاست سيو للمطورين والمدونين" width="1200" height="630" loading="eager" decoding="async" />
    </section>
    <section class="mseo-section" id="tool-directory" data-tools-directory>
      <div class="mseo-section-head">
        <div><h2>كل الأدوات في شبكة واحدة</h2><p>ابحث باسم الأداة أو اختر مجالها للوصول بسرعة.</p></div>
        <span class="mseo-tools-total">{tools.length} أداة</span>
      </div>
      <div class="mseo-tools-filters">
        <label><span>البحث في الأدوات</span><input type="search" data-tool-search placeholder="ابحث عن أداة…" aria-label="ابحث في الأدوات" /></label>
        <label><span>المجال</span><select data-tool-category><option value="">كل المجالات</option>{categories.map((category) => <option value={category}>{category}</option>)}</select></label>
        <p data-tool-count aria-live="polite">{tools.length} أداة</p>
      </div>
      <div class="mseo-tools-grid">
        {tools.map((tool) => <ToolCard tool={tool} />)}
      </div>
      <p class="mseo-tools-empty" data-tools-empty hidden>لا توجد أدوات تطابق البحث الحالي. غيّر عبارة البحث أو اختر مجالًا آخر.</p>
    </section>
    <section class="mseo-section mseo-tools-note">
      <span class="mseo-eyebrow">استخدام آمن</span>
      <h2>راجع النتائج قبل اعتمادها</h2>
      <p>تختلف المدخلات والمخرجات والقيود حسب وظيفة كل أداة. تجنب إدخال كلمات المرور ومفاتيح API والبيانات السرية، واختبر الشيفرات والإعدادات قبل نشرها في موقع فعلي.</p>
    </section>
  </main>
</SiteLayout>
<script>
  const directory = document.querySelector('[data-tools-directory]');
  if (directory) {
    const search = directory.querySelector('[data-tool-search]');
    const category = directory.querySelector('[data-tool-category]');
    const count = directory.querySelector('[data-tool-count]');
    const empty = directory.querySelector('[data-tools-empty]');
    const cards = [...directory.querySelectorAll('[data-tool-card]')];
    const filter = () => {
      const term = (search?.value || '').trim().toLocaleLowerCase();
      const selected = category?.value || '';
      let visible = 0;
      for (const card of cards) {
        const matches = (!term || card.textContent.toLocaleLowerCase().includes(term)) &&
          (!selected || card.dataset.toolCategory === selected);
        card.hidden = !matches;
        if (matches) visible += 1;
      }
      if (count) count.textContent = visible + ' / ' + cards.length + ' أداة';
      if (empty) empty.hidden = visible > 0;
    };
    search?.addEventListener('input', filter);
    category?.addEventListener('change', filter);
  }
</script>

