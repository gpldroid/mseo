---
import Layout from '../../layouts/Layout.astro';
import articles from '../../../data/articles.json';
const categories=[{"name":"SEO","slug":"seo","desc":"تحسين محركات البحث، الفهرسة، الكلمات المفتاحية والتحسين التقني."},{"name":"الذكاء الاصطناعي","slug":"ai","desc":"أدلة الذكاء الاصطناعي وهندسة الأوامر والوكلاء والأتمتة."},{"name":"البرمجة","slug":"programming","desc":"لغات البرمجة ومفاهيم JavaScript وTypeScript وأدوات المطورين."},{"name":"تطوير المواقع","slug":"web-development","desc":"بناء المواقع وHTML وCSS والتطوير المتجاوب."},{"name":"أداء المواقع","slug":"web-performance","desc":"سرعة المواقع وCore Web Vitals وتحسين الأداء."},{"name":"تصميم المواقع","slug":"web-design","desc":"تصميم الواجهات وتجربة المستخدم وإمكانية الوصول."}];
const counts=Object.fromEntries(categories.map(c=>[c.name,articles.filter(a=>a.category===c.name).length]));
---
<Layout title="التصنيفات | MSEO" description="استكشف تصنيفات MSEO التقنية واختر المجال الذي تريد التعلم فيه.">
<main class="container page-shell"><section class="page-hero"><span class="eyebrow">EXPLORE KNOWLEDGE</span><h1>اكتشف حسب <em>التصنيف</em></h1><p>مكتبة منظمة من المقالات والأدلة العملية في الذكاء الاصطناعي والبرمجة والويب وتحسين محركات البحث.</p></section>
<section class="category-grid">{categories.map(c=><a class="category-card" href={'/topics/'+c.slug+'.html'}><span class="category-card__icon">✦</span><span class="eyebrow">MSEO TOPIC</span><h2>{c.name}</h2><p>{c.desc}</p><div><strong>{counts[c.name]||0}</strong><span>مقالاً</span><b>استكشف المجال ←</b></div></a>)}</section></main></Layout>