---
const tabs = [
  { href: '/', label: 'الرئيسية', icon: '⌂', active: Astro.url.pathname === '/' },
  { href: '/#articles', label: 'المقالات', icon: '▤', active: Astro.url.pathname.startsWith('/articles/') },
  { href: '/pages/categories.html', label: 'التصنيفات', icon: '◈', active: Astro.url.pathname === '/pages/categories.html' },
  { href: '/pages/tools.html', label: 'الأدوات', icon: '✣', active: Astro.url.pathname === '/pages/tools.html' },
  { href: '/pages/archive.html', label: 'استكشف', icon: '⌕', active: Astro.url.pathname === '/pages/archive.html' }
];
---
<nav class="mseo-bottom-tabs" data-3d-tab-bar aria-label="التنقل الرئيسي السفلي">
  {tabs.map((tab) => <a class="mseo-tab" href={tab.href} aria-current={tab.active ? 'page' : undefined}><span class="mseo-tab-icon" aria-hidden="true">{tab.icon}</span><span>{tab.label}</span></a>)}
</nav>
