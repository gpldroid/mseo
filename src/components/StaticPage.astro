---
import BottomTabBar from './BottomTabBar.astro';
import { stripStyleMarkup } from '../utils/strip-styles.js';
const { page } = Astro.props;
---
<!doctype html>
<html {...page.htmlAttrs}>
  <head><Fragment set:html={stripStyleMarkup(page.headHtml)} /></head>
  <body {...page.bodyAttrs}>
    <Fragment set:html={stripStyleMarkup(page.bodyHtml)} />
    {!page.hasSiteScript && <script is:inline src="/assets/js/site.js" defer></script>}
    <BottomTabBar />
    <script is:inline src="/assets/js/mseo-bottom-tabs.js" defer></script>
  </body>
</html>
