---
const { category } = Astro.props;
---
<a class="mseo-category-card" href={`/pages/topics.html#topic-${category.slug}`}>
  <img src={category.image} alt="" width="1200" height="630" loading="lazy" decoding="async" />
  <div class="mseo-category-card-body">
    <div class="mseo-category-card-meta">
      <span class="mseo-category-icon" aria-hidden="true">{category.icon}</span>
      <span class="mseo-category-count">{category.count} مقال</span>
    </div>
    <h2>{category.name}</h2>
    <p>{category.description}</p>
    <span class="mseo-category-link">استكشف التصنيف <span aria-hidden="true">←</span></span>
  </div>
</a>

