---
const { category } = Astro.props;
---
<a class="mseo-category-card" href={`/pages/topics.html#topic-${category.slug}`}>
  <img src={category.image} alt="" width="1200" height="630" loading="lazy" decoding="async" />
  <div class="mseo-category-card-body">
    <div class="mseo-category-card-meta">
      <span class="mseo-category-icon" aria-hidden="true">{category.icon}</span>
      <span class="mseo-category-count">{category.count} مقال</span>
    </div>
    <h2>{category.name}</h2>
    <p>{category.description}</p>
    <span class="mseo-category-link">استكشف التصنيف <span aria-hidden="true">←</span></span>
  </div>
</a>
<style>
  .mseo-category-card{display:block;overflow:hidden;border:1px solid var(--line);border-radius:20px;background:var(--surface);color:var(--ink);box-shadow:var(--mseo-depth);transition:transform .2s,border-color .2s}
  .mseo-category-card:hover{transform:translateY(-5px);border-color:var(--gold);color:var(--ink)}
  .mseo-category-card>img{display:block;width:100%;aspect-ratio:1200/630;object-fit:cover;background:var(--paper-deep)}
  .mseo-category-card-body{padding:18px 20px 21px}
  .mseo-category-card-meta{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:8px}
  .mseo-category-icon{display:grid;place-items:center;width:42px;height:42px;border-radius:13px;background:#f2ead9;color:var(--gold-deep);font-size:1.25rem}
  .mseo-category-count{border:1px solid var(--line);border-radius:999px;padding:4px 10px;color:var(--muted);font-size:.78rem;font-weight:800}
  .mseo-category-card h2{margin:8px 0;color:var(--ink);font-size:1.18rem;font-weight:900}
  .mseo-category-card p{margin:0 0 14px;color:var(--muted);font-size:.9rem;line-height:1.9}
  .mseo-category-link{display:inline-flex;gap:8px;align-items:center;color:var(--gold-deep);font-weight:900;font-size:.88rem}
</style>
