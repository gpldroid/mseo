---
const { article } = Astro.props;
const image = article.thumbnail || article.image || '/assets/favicon.svg';
---
<article class="mseo-article-card">
  <a class="mseo-article-image" href={`/articles/${article.file || article.slug + '.html'}`} aria-label={article.title}>
    <img src={image} alt="" width="640" height="360" loading="lazy" decoding="async" />
  </a>
  <div class="mseo-article-card-body">
    <span class="mseo-article-category">{article.category || 'مقالات'}</span>
    <h3><a href={`/articles/${article.file || article.slug + '.html'}`}>{article.title}</a></h3>
    <p>{article.description || ''}</p>
    <a class="mseo-article-link" href={`/articles/${article.file || article.slug + '.html'}`}>اقرأ المقال <span aria-hidden="true">←</span></a>
  </div>
</article>

