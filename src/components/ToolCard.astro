---
const { tool } = Astro.props;
const symbols = {
  search: '⌕', tags: '◇', 'file-text': '▤', link: '↗', code: '</>',
  bot: '✧', entities: '⌘', schema: '{ }', palette: '◈', layers: '▧', minify: '⇣'
};
---
<article class="mseo-tool-card" data-tool-card data-tool-category={tool.kicker}>
  <span class="mseo-tool-icon" aria-hidden="true">{symbols[tool.icon] || '✦'}</span>
  <span class="mseo-tool-kicker">{tool.kicker}</span>
  <h2>{tool.title}</h2>
  <p>{tool.description}</p>
  <a href={`/pages/${tool.href}`} class="mseo-tool-link">استخدام الأداة <span aria-hidden="true">←</span></a>
</article>
<style>
  .mseo-tool-card{display:flex;min-width:0;flex-direction:column;align-items:flex-start;padding:19px;border:1px solid var(--line);border-radius:18px;background:linear-gradient(155deg,var(--surface),var(--paper));box-shadow:var(--mseo-depth);transition:transform .2s,border-color .2s}
  .mseo-tool-card:hover{transform:translateY(-4px);border-color:var(--gold)}
  .mseo-tool-icon{display:grid;place-items:center;width:45px;height:45px;margin-bottom:12px;border-radius:14px;background:#f2ead9;color:var(--gold-deep);font-size:1.2rem;font-weight:900}
  .mseo-tool-kicker{color:var(--gold-deep);font-size:.76rem;font-weight:900}
  .mseo-tool-card h2{margin:7px 0;color:var(--ink);font-size:1.02rem;line-height:1.6;font-weight:900}
  .mseo-tool-card p{margin:0 0 16px;color:var(--muted);font-size:.88rem;line-height:1.85;flex:1}
  .mseo-tool-link{display:inline-flex;align-items:center;gap:8px;color:var(--gold-deep);font-size:.88rem;font-weight:900}
  .mseo-tool-card[hidden]{display:none}
</style>
