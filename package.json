{
  "name": "mseo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate:catalog": "node scripts/generate-article-catalog.mjs",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "generate:rss": "node scripts/generate-rss.mjs",
    "build": "npm run sync:cms && npm run generate:catalog && npm run generate:sitemap && npm run generate:rss && node scripts/normalize-seo-urls.mjs",
    "test:js": "node scripts/check-javascript.mjs",
    "test": "npm run test:js && node scripts/validate-site.mjs",
    "sync:cms": "node scripts/sync-cms-content.mjs",
    "generate:social-images": "node scripts/generate-social-images.mjs",
    "audit:seo": "node scripts/audit-seo.mjs",
    "audit:i18n": "node scripts/audit-translations.mjs"
  }
}
