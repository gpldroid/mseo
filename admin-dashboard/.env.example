# Supabase project settings. Use the publishable/anon key only in the browser.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional base path for static hosting. Use "/" for Vercel/Netlify.
VITE_BASE_PATH=/

# Never add service_role keys, GitHub personal access tokens, or private secrets here.